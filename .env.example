# Copy to .env.local. API_URL and SITE_URL are read on the server at run time.

# The Spring backend, as this server reaches it. Never sent to the browser.
API_URL=http://localhost:9004

# This site's public address: canonical links, the sitemap and search-engine data.
SITE_URL=https://riwaajevents.com

# Optional, read at BUILD time. The file server that holds photos uploaded through the CMS, with a
# trailing slash (the backend's file.url). When set, those photos go through the image optimiser.
# Leave it unset for a file server on localhost: the optimiser refuses local addresses, and photos
# are then shown as uploaded.
# NEXT_PUBLIC_FILE_URL=https://files.example.com/
